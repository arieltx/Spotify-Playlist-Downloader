<Window x:Class="SpotiFetch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotiFetch" Height="860" Width="1240"
        MinHeight="680" MinWidth="900" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="RetryRowButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelado"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FolderRowButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Concluído"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Já baixada"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilePathTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding FilePath}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupCollapseButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" />
                                    <ToggleButton x:Name="DropDownButton" Width="30" HorizontalAlignment="Right" Focusable="False" ClickMode="Press" Content="▾" Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="DropBorder" Background="{TemplateBinding Background}" CornerRadius="0,7,7,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropBorder" Property="Background" Value="#203342" /></Trigger>
                                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="DropBorder" Property="Background" Value="#1B3A2D" /></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="DropBorder" Property="Opacity" Value="0.75" /></Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropBorder" Property="Opacity" Value="0.5" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="#07130D" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="PlayerPreviousIcon">M 19,4 L 8,12 L 19,20 Z M 5,4 L 3,4 L 3,20 L 5,20 Z</Geometry>
        <Geometry x:Key="PlayerNextIcon">M 5,4 L 16,12 L 5,20 Z M 19,4 L 21,4 L 21,20 L 19,20 Z</Geometry>
        <Geometry x:Key="PlayerPlayIcon">M 6,3 L 21,12 L 6,21 Z</Geometry>
        <Geometry x:Key="PlayerPauseIcon">M 5,4 L 9,4 L 9,20 L 5,20 Z M 15,4 L 19,4 L 19,20 L 15,20 Z</Geometry>
        <Geometry x:Key="PlayerVolumeIcon">M 2,9 L 7,9 L 14,4 L 14,20 L 7,15 L 2,15 Z M 17,8 Q 22,12 17,16</Geometry>
        <Geometry x:Key="PlayerMutedIcon">M 2,9 L 7,9 L 14,4 L 14,20 L 7,15 L 2,15 Z M 17,9 L 22,15 M 22,9 L 17,15</Geometry>
        <Style x:Key="PlayerTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42" /><Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="9" /><Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>
        <Style x:Key="PlayerVolumeButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerTransportButtonStyle}">
            <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="PlayerSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Ellipse x:Name="ThumbShape" Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerSliderButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="3" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center" Height="18"><Border Height="4" Background="{StaticResource BorderBrushSoft}" CornerRadius="2" VerticalAlignment="Center"/><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PlayerSliderButtonStyle}" Background="{StaticResource AccentBrush}" /></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PlayerSliderButtonStyle}" Background="{StaticResource BorderBrushSoft}" /></Track.IncreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource PlayerSliderThumbStyle}" /></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerSeekSliderStyle" TargetType="Slider" BasedOn="{StaticResource PlayerVolumeSliderStyle}">
            <Setter Property="Height" Value="18" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="#FF6B6B" />
                    <Setter Property="Background" Value="#2A171D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GreenToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                            <Grid Width="58" Height="28" Margin="10,0,0,0">
                                <Border x:Name="SwitchTrack" CornerRadius="17" Background="#34424F"
                                        BorderBrush="#586775" BorderThickness="1" />
                                <TextBlock x:Name="OffText" Text="OFF" FontSize="8" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Margin="0,0,7,0" IsHitTestVisible="False" />
                                <TextBlock x:Name="OnText" Text="ON" FontSize="8" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Margin="7,0,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Ellipse x:Name="SwitchThumb" Width="22" Height="22" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="33,0,0,0" />
                                <Setter TargetName="OffText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="OnText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1016" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="8,10,8,26">
                    <TextBlock Text="♫  SPOTIFETCH" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Música para sua biblioteca" Foreground="{StaticResource MutedBrush}" Margin="2,5,0,0" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="BIBLIOTECA" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="8,0,0,8" />
                    <Button x:Name="NavHome" Tag="HomePage" Content="⌂   Início" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Left" />
                    <Button x:Name="NavDownloads" Tag="DownloadsPage" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="↓   Downloads" VerticalAlignment="Center" /><Border x:Name="DownloadsBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="20" Padding="6,1" CornerRadius="9" Background="{StaticResource AccentBrush}"><TextBlock x:Name="DownloadsBadgeText" FontSize="10" FontWeight="Bold" Foreground="#07130D" HorizontalAlignment="Center" /></Border></Grid></Button>
                    <Button x:Name="NavQueue" Tag="QueuePage" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="☷   Fila de downloads" VerticalAlignment="Center" /><Border x:Name="QueueBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="20" Padding="6,1" CornerRadius="9" Background="{StaticResource AccentBrush}"><TextBlock x:Name="QueueBadgeText" FontSize="10" FontWeight="Bold" Foreground="#07130D" HorizontalAlignment="Center" /></Border></Grid></Button>
                    <Button x:Name="NavCompleted" Tag="CompletedPage" Content="✓   Concluídos" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Left" />
                    <Button x:Name="NavActivity" Tag="ActivityPage" Content="◷   Atividade" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Left" />
                    <Button x:Name="NavLogs" Tag="LogsPage" Content="☰   Logs" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Left" />
                    <Button x:Name="NavPlayer" Tag="PlayerPage" Content="♫   Player" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Left" />
                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="8,15" />
                    <Button x:Name="NavSettings" Tag="SettingsPage" Content="⚙   Configurações" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Left" />
                    <Button x:Name="NavAbout" Tag="AboutPage" Content="ⓘ   Sobre" Click="NavigationButton_Click" Margin="0,2" Padding="12,11" HorizontalContentAlignment="Left" />
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="11" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="DOWNLOADS ATIVOS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                        <TextBlock x:Name="SidebarActiveText" Text="0 ativos · fila vazia" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" FontSize="11" />
                        <TextBlock x:Name="StatusText" Text="●  PRONTO" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" FontSize="10" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="2,0,2,18">
                    <StackPanel><TextBlock Text="Início" FontSize="27" FontWeight="Bold"/><TextBlock Text="Encontre música ou cole um link do Spotify" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="InputBox" Height="48" VerticalContentAlignment="Center" ToolTip="Cole link Spotify ou digite música e artista" TextChanged="InputBox_TextChanged" KeyDown="InputBox_KeyDown" />
                            <TextBlock x:Name="InputHint" Text="Cole um link Spotify ou digite o nome da música e artista" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Margin="8,0,0,0" IsEnabled="False" Click="CancelButton_Click" />
                        <Button Grid.Column="2" Content="Importar TXT" Margin="8,0,0,0" Click="ImportTxtButton_Click" />
                        <Button x:Name="SearchButton" Grid.Column="3" Content="Buscar e baixar" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="SearchButton_Click" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}"><Grid><TextBlock x:Name="PlaylistCoverFallback" Text="♫" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PlaylistCoverImage" Stretch="UniformToFill" Visibility="Collapsed"/></Grid></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NowTitle" Text="Pronto para buscar" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="NowDetail" Text="Cole um link ou digite o nome de uma faixa" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="QueueSummary" Text="Aguardando playlist" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock x:Name="CompletedSummary" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,0"/><TextBlock x:Name="SkippedSummary" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,0"/><TextBlock x:Name="PendingSummary" Foreground="#FFFFC266" FontSize="11" Margin="12,0,0,0"/><TextBlock x:Name="ErrorSummary" Foreground="#FFFF6B6B" FontSize="11" Margin="10,0,0,0"/></StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="Acesso rápido" FontSize="17" FontWeight="SemiBold"/><Button Content="Abrir downloads" HorizontalAlignment="Left" Margin="0,14,0,0" Click="GoDownloads_Click"/><Button Content="Preferências de download" HorizontalAlignment="Left" Margin="0,8,0,0" Click="GoSettings_Click"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="8,0,0,0">
                        <StackPanel><TextBlock Text="Atividade recente" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><ListBox x:Name="HomeRecentList" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="4"/></StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="4" Margin="4,12,4,0"><TextBlock x:Name="ProgressSummary" Text="" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><ProgressBar x:Name="OverallProgress" Width="280" Height="7" Maximum="100" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            </Grid>

            <Grid x:Name="DownloadsPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="2,0,2,18"><StackPanel><TextBlock Text="Downloads" FontSize="27" FontWeight="Bold"/><TextBlock Text="Acompanhe o progresso das suas músicas" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="ϟ" Foreground="{StaticResource AccentBrush}" FontSize="22" Margin="0,0,8,0"/><TextBlock Text="Velocidade total" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="OverallSpeedText" Text="—" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Grid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="12,9" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartAllButton" Content="▶  Iniciar tudo" Click="StartAllButton_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="PauseAllButton" Content="Ⅱ  Pausar tudo" Click="PauseAllButton_Click" IsEnabled="False" Margin="0,0,8,0" ToolTip="Faixas em andamento terminam normalmente; os próximos itens aguardam até retomar."/><Button x:Name="DownloadCancelButton" Content="×  Cancelar tarefas" Click="CancelButton_Click" IsEnabled="False"/></StackPanel><TextBlock Grid.Column="1" Text="A fila continua ativa ao navegar entre páginas" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></Grid>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,12">
