<Window x:Class="LaurusDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotiFetch" Height="800" Width="1080"
        MinHeight="680" MinWidth="860" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="#FF6B6B" />
                    <Setter Property="Background" Value="#2A171D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GreenToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                            <Grid Width="58" Height="28" Margin="10,0,0,0">
                                <Border x:Name="SwitchTrack" CornerRadius="17" Background="#34424F"
                                        BorderBrush="#586775" BorderThickness="1" />
                                <TextBlock x:Name="OffText" Text="OFF" FontSize="8" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Margin="0,0,7,0" IsHitTestVisible="False" />
                                <TextBlock x:Name="OnText" Text="ON" FontSize="8" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Margin="7,0,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Ellipse x:Name="SwitchThumb" Width="22" Height="22" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="33,0,0,0" />
                                <Setter TargetName="OffText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="OnText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,20,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,16">
            <StackPanel>
                <TextBlock Text="SPOTIFETCH" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Música para sua biblioteca" Foreground="{StaticResource MutedBrush}" Margin="1,3,0,0" />
            </StackPanel>
            <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="46" Height="42"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    FontSize="19" Click="SettingsButton_Click" ToolTip="Configurações" />
            <Button Content="Importar TXT" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,56,0" Click="ImportTxtButton_Click" ToolTip="Importar uma lista de faixas" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="InputBox" Height="46" VerticalContentAlignment="Center"
                             ToolTip="Cole um link Spotify ou digite nome da música e artista"
                             TextChanged="InputBox_TextChanged" KeyDown="InputBox_KeyDown" />
                    <TextBlock x:Name="InputHint" Text="Cole um link Spotify ou digite o nome da música e artista"
                               Margin="15,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                </Grid>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Margin="8,0,0,0"
                        IsEnabled="False" Click="CancelButton_Click" />
                <Button x:Name="SearchButton" Grid.Column="2" Content="Buscar e baixar" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="SearchButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}">
                    <TextBlock Text="♫" FontSize="25" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NowTitle" Text="Pronto para buscar" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="NowDetail" Text="Cole um link ou digite o nome de uma faixa"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock x:Name="QueueSummary" Text="0 faixas na fila" Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" />
                        <TextBlock x:Name="ErrorSummary" Text="" Foreground="#FFFF6B6B" FontSize="11" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,0,12">
            <TabControl>
                <TabItem Header="Downloads">
                    <DataGrid x:Name="DownloadsGrid" ItemsSource="{Binding Tracks}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="54" />
                            <DataGridTextColumn Header="MÚSICA" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="ARTISTA" Binding="{Binding Artist}" Width="220" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="150" />
                            <DataGridTemplateColumn Header="PROGRESSO" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Atividade">
                    <ListBox x:Name="ActivityList" Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="12" />
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="5" Margin="4,0,4,0">
            <TextBlock x:Name="StatusText" Text="●  PRONTO" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="280">
                <TextBlock x:Name="ProgressSummary" Text="" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,0,5" />
                <ProgressBar x:Name="OverallProgress" Value="0" Maximum="100" />
            </StackPanel>
        </Grid>

        <!-- Settings drawer overlays the existing view, so opening it never shifts the layout. -->
        <Border x:Name="SettingsPanel" Grid.RowSpan="6" Panel.ZIndex="20"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="340"
                Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,54,0,2"
                Visibility="Collapsed" Opacity="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="CONFIGURAÇÕES" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Preferências de download" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="QUALIDADE DE ÁUDIO · MP3" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,24">
                        <RadioButton x:Name="Quality320" Content="320" Tag="320" GroupName="Quality" Checked="Quality_Checked" />
                        <RadioButton x:Name="Quality256" Content="256" Tag="256" GroupName="Quality" Checked="Quality_Checked" />
                        <RadioButton x:Name="Quality128" Content="128" Tag="128" GroupName="Quality" Checked="Quality_Checked" />
                    </StackPanel>
                    <TextBlock Text="THREADS DE DOWNLOAD" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <UniformGrid Columns="2" Margin="0,10,0,8">
                        <RadioButton x:Name="Workers1" Content="1 thread" Tag="1" GroupName="Workers" Checked="WorkersPreset_Checked" />
                        <RadioButton x:Name="Workers4" Content="4 threads" Tag="4" GroupName="Workers" Checked="WorkersPreset_Checked" />
                        <RadioButton x:Name="Workers6" Content="6 threads" Tag="6" GroupName="Workers" Checked="WorkersPreset_Checked" />
                        <RadioButton x:Name="Workers8" Content="8 threads" Tag="8" GroupName="Workers" Checked="WorkersPreset_Checked" />
                        <RadioButton x:Name="WorkersCustom" Content="Personalizado" Tag="custom" GroupName="Workers" Checked="WorkersPreset_Checked" />
                    </UniformGrid>
                    <StackPanel x:Name="CustomWorkersPanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <Slider x:Name="WorkersSlider" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="WorkersSlider_ValueChanged" />
                        <TextBlock x:Name="WorkersValueText" Text="3 threads" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,4,0,20" />
                    <TextBlock Text="PASTA DE SAÍDA" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="OutputPathText" Text="Downloads" TextWrapping="Wrap" Margin="0,8,0,12" />
                    <Button Content="Escolher pasta" HorizontalAlignment="Stretch" Click="ChooseFolderButton_Click" />
                    <CheckBox x:Name="SkipExistingCheckBox" Content="Pular músicas já baixadas" Margin="0,18,0,0"
                              Style="{StaticResource GreenToggleCheckBoxStyle}"
                              IsChecked="True" Checked="SkipExisting_Checked" Unchecked="SkipExisting_Checked" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
